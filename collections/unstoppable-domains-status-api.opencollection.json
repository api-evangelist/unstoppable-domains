        },
        {
          "info": {
            "name": "List supported tlds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.unstoppabledomains.com/partner/v3/supported_tlds"
          },
          "docs": "List supported tlds"
        }
      ]
    }
  ],
  "bundled": true
}