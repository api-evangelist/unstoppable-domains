{
  "opencollection": "1.0.0",
  "info": {
    "name": "Web3 Partner API v3 account Leads API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Leads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List domain conversation leads",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.unstoppabledomains.com/partner/v3/mcp/v1/actions/ud_leads_list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List conversations about domains you own or are interested in. Includes buyer-seller messaging threads."
        },
        {
          "info": {
            "name": "Get or create domain conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.unstoppabledomains.com/partner/v3/mcp/v1/actions/ud_lead_get",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start or find an existing conversation with the seller of a domain. Returns existing conversation if one already exists."
        },
        {
          "info": {
            "name": "List messages in a conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.unstoppabledomains.com/partner/v3/mcp/v1/actions/ud_lead_messages_list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get messages in a domain conversation. Messages are returned newest-first with cursor-based pagination."
        },
        {
          "info": {
            "name": "Send a message in a conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.unstoppabledomains.com/partner/v3/mcp/v1/actions/ud_lead_message_send",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send a message in a domain conversation. Messages are encrypted at rest."
        }
      ]
    }
  ],
  "bundled": true
}